# JanSamachar environment template
# Copy this file to .env.local and fill in real values locally.
# Never commit .env.local or any real API credentials.

# YouTube Data API v3
EXPO_PUBLIC_YOUTUBE_API_KEY=your_youtube_api_key_here

# Google Gemini API
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here

# NewsData.io
EXPO_PUBLIC_NEWSDATA_API_KEY=your_newsdata_api_key_here

# NewsAPI.org
EXPO_PUBLIC_NEWS_API_KEY=your_newsapi_key_here

# RSS2JSON
EXPO_PUBLIC_RSS2JSON_KEY=your_rss2json_key_here

# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key_here

# CountryStateCity API
EXPO_PUBLIC_CSC_API_KEY=your_countrystatecity_api_key_here

# Agora.io
EXPO_PUBLIC_AGORA_APP_ID=your_agora_app_id_here

# App mode: true for demo/mock data, false for live APIs
EXPO_PUBLIC_DEMO_MODE=true
